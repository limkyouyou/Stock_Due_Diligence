# API key used by the future live financial-data collector.
STOCK_DD_FINANCIAL_API_KEY=

# Directory where unmodified provider responses will be stored.
STOCK_DD_RAW_DATA_DIR=data/raw

# Local SQLite database containing normalized application data.
STOCK_DD_DATABASE_PATH=data/stock_dd.sqlite3

# SEC automated requests require an identigying User-Agent.
# Example format: Stock DD MAS contact@example.com
STOCK_DD_SEC_USER_AGENT=